---
interface Props {
  activeTab?: string;
  path?: string;
  hints?: string;
}

const { activeTab = 'projects', path = '~', hints = 'INSERT' } = Astro.props;

const tabs = [
  { id: 'projects', label: 'projects', href: '/' },
  { id: 'photos', label: 'photos', href: '/photos' },
  { id: 'blog', label: 'blog', href: '/blog' },
];
---

<div class="tmux-bar">
  <div class="tmux-left">
    <a href="/" class="tmux-session">[error-signal]</a>
    <nav class="tmux-tabs">
      {tabs.map((tab, index) => (
        <a
          href={tab.href}
          class:list={['tmux-tab', { active: activeTab === tab.id }]}
        >
          {index}:{tab.label}{activeTab === tab.id ? '*' : ''}
        </a>
      ))}
    </nav>
  </div>
  <div class="tmux-right">
    <span class="tmux-hints" id="tmux-hints">{hints}</span>
    <span class="tmux-path">{path}</span>
    <span class="tmux-time" id="tmux-time"></span>
  </div>
</div>

<script>
  function updateTime() {
    const timeEl = document.getElementById('tmux-time');
    if (timeEl) {
      const now = new Date();
      const time = now.toLocaleTimeString('en-US', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      });
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      timeEl.textContent = `${time} ${year}-${month}-${day}`;
    }
  }

  function setupClock() {
    updateTime();
  }

  setupClock();
  setInterval(updateTime, 1000);
  document.addEventListener('astro:after-swap', setupClock);
</script>

<style>
  .tmux-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--es-bg0);
    color: var(--es-fg);
    font-size: 12px;
    height: 20px;
    flex-shrink: 0;
  }

  .tmux-left {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .tmux-session {
    color: var(--es-black);
    background-color: var(--es-green);
    padding: 0 8px;
    font-weight: bold;
    text-decoration: none;
    height: 100%;
    display: flex;
    align-items: center;
    position: relative;
  }

  /* Arrow pointing right after [error-signal] */
  .tmux-session::after {
    content: '';
    position: absolute;
    top: 0;
    right: -10px;
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-left: 10px solid var(--es-green);
    z-index: 10;
  }

  .tmux-tabs {
    display: flex;
    align-items: center;
    margin-left: 14px;
  }

  .tmux-tab {
    color: var(--es-grey);
    text-decoration: none;
    padding: 0 8px;
    transition: color var(--es-duration-fast);
  }

  .tmux-tab:hover {
    color: var(--es-fg);
  }

  .tmux-tab.active {
    color: var(--es-fg);
  }

  .tmux-right {
    display: flex;
    align-items: center;
    height: 100%;
  }

  /* INSERT/NORMAL mode indicator */
  .tmux-hints {
    color: var(--es-black);
    background-color: var(--es-green);
    font-weight: bold;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 8px 0 16px;
    position: relative;
  }

  /* Left-pointing arrow (carve out from INSERT) */
  .tmux-hints::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 10px solid var(--es-bg0);
    border-bottom: 10px solid var(--es-bg0);
    border-right: 10px solid transparent;
  }

  :global(.tmux-hints.normal-mode) {
    background-color: var(--es-blue);
  }

  /* Path section */
  .tmux-path {
    color: var(--es-fg);
    background-color: var(--es-bg4);
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 8px 0 16px;
    position: relative;
    font-weight: bold;
  }

  /* Left-pointing arrow (carve out from path, showing INSERT color) */
  .tmux-path::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 10px solid var(--es-green);
    border-bottom: 10px solid var(--es-green);
    border-right: 10px solid transparent;
  }

  :global(.tmux-hints.normal-mode ~ .tmux-path)::before {
    border-top-color: var(--es-blue);
    border-bottom-color: var(--es-blue);
  }

  /* Time section */
  .tmux-time {
    color: var(--es-black);
    background-color: var(--es-orange);
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 8px 0 16px;
    position: relative;
    font-weight: bold;
  }

  /* Left-pointing arrow (carve out from time, showing path color) */
  .tmux-time::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 10px solid var(--es-bg4);
    border-bottom: 10px solid var(--es-bg4);
    border-right: 10px solid transparent;
  }

  @media (max-width: 640px) {
    .tmux-bar {
      font-size: 11px;
      height: 18px;
    }

    .tmux-tab {
      padding: 0 4px;
    }

    .tmux-session {
      padding: 0 4px;
    }

    .tmux-session::after {
      right: -9px;
      border-top-width: 9px;
      border-bottom-width: 9px;
      border-left-width: 9px;
    }

    .tmux-tabs {
      margin-left: 12px;
    }

    .tmux-hints,
    .tmux-path,
    .tmux-time {
      padding: 0 4px 0 12px;
    }

    .tmux-hints::before,
    .tmux-path::before,
    .tmux-time::before {
      border-top-width: 9px;
      border-bottom-width: 9px;
      border-right-width: 9px;
    }
  }
</style>
