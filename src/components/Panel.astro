---
interface Props {
  title?: string;
  focused?: boolean;
  class?: string;
}

const { title, focused = false, class: className = '' } = Astro.props;
---

<div class:list={['panel', { focused }, className]}>
  {title && (
    <div class="panel-title-bar">
      <span class="panel-title">{title}</span>
    </div>
  )}
  <div class="panel-content">
    <slot />
  </div>
</div>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: var(--es-bg-dim);
    border: 1px solid var(--es-border);
    border-radius: 2px;
  }

  .panel.focused {
    border-color: var(--es-green);
  }

  .panel-title-bar {
    padding: var(--es-space-2) var(--es-space-4);
    background-color: var(--es-bg0);
    border-bottom: 1px solid var(--es-border);
  }

  .panel.focused .panel-title-bar {
    border-bottom-color: var(--es-green);
  }

  .panel-title {
    color: var(--es-grey);
    font-size: var(--es-text-sm);
    font-family: var(--es-font-mono);
  }

  .panel.focused .panel-title {
    color: var(--es-green);
  }

  .panel-content {
    flex-grow: 1;
    padding: var(--es-space-4);
    min-height: 0;
    overflow: auto;
  }
</style>
