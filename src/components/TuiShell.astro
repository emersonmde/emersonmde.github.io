---
import TmuxStatusBar from './TmuxStatusBar.astro';

interface Props {
  currentPath?: string;
  virtualPath?: string;
  statusHints?: string;
  activeTab?: string;
}

const { currentPath = '/', virtualPath = '~', statusHints = '', activeTab = 'projects' } = Astro.props;
---

<div class="terminal">
  <div class="terminal-window">
    <div class="terminal-content" id="terminal-content">
      <div id="main-content">
        <slot />
      </div>

      <div id="terminal-output"></div>

      <div class="prompt-line" id="prompt-line">
        <span class="prompt-symbol">❯</span>
        <div class="prompt-input-wrapper">
          <input
            type="text"
            class="prompt-input"
            id="command-input"
            placeholder=""
            autocomplete="off"
            spellcheck="false"
            aria-label="Command input"
          />
          <span class="prompt-cursor"></span>
        </div>
      </div>

    </div>

    <TmuxStatusBar activeTab={activeTab} path={virtualPath} hints={statusHints} />
  </div>
</div>

<script>
  interface VimWindow extends Window {
    vimMode: boolean;
  }
  declare const window: VimWindow;

  function getInput() {
    return document.getElementById('command-input') as HTMLInputElement | null;
  }

  function getTerminalOutput() {
    return document.getElementById('terminal-output') as HTMLDivElement | null;
  }

  function getTerminalContent() {
    return document.getElementById('terminal-content') as HTMLDivElement | null;
  }

  function getPromptSymbol() {
    return document.querySelector('.prompt-symbol') as HTMLElement | null;
  }

  function getHintsElement() {
    return document.querySelector('.tmux-hints') as HTMLSpanElement | null;
  }

  let commandHistory: string[] = [];
  let historyIndex = -1;

  if (window.vimMode === undefined) {
    window.vimMode = false;
  }

  function setVimMode(enabled: boolean) {
    window.vimMode = enabled;
    const input = getInput();
    const promptSymbol = getPromptSymbol();
    const hintsElement = getHintsElement();

    if (enabled) {
      input?.blur();
      promptSymbol?.classList.add('vim-mode');
      if (hintsElement) {
        hintsElement.textContent = 'NORMAL';
        hintsElement.classList.add('normal-mode');
      }
    } else {
      promptSymbol?.classList.remove('vim-mode');
      if (hintsElement) {
        hintsElement.textContent = 'INSERT';
        hintsElement.classList.remove('normal-mode');
      }
    }
  }

  function scrollToBottom() {
    const promptLine = document.getElementById('prompt-line');
    const terminalContent = getTerminalContent();
    if (promptLine) {
      promptLine.scrollIntoView({ behavior: 'smooth', block: 'end' });
    }
    if (terminalContent) {
      terminalContent.scrollTop = terminalContent.scrollHeight;
    }
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
  }

  function isVimMode() {
    return window.vimMode === true;
  }

  function setupInputListeners() {
    const input = getInput();
    if (!input) return;

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const command = input.value.trim();
        if (command) {
          executeCommand(command);
          commandHistory.unshift(command);
          historyIndex = -1;
        }
        input.value = '';
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIndex < commandHistory.length - 1) {
          historyIndex++;
          input.value = commandHistory[historyIndex] || '';
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          input.value = commandHistory[historyIndex] || '';
        } else if (historyIndex === 0) {
          historyIndex = -1;
          input.value = '';
        }
      }
    });

    input.addEventListener('focus', () => {
      scrollToBottom();
    });
  }

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const input = getInput();

    if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') {
      if (target !== input) return;
    }

    if (e.key === 'Escape') {
      e.preventDefault();
      if (isVimMode()) {
        setVimMode(false);
        input?.focus();
      } else {
        setVimMode(true);
        if (input) input.value = '';
      }
      return;
    }

    if (isVimMode()) {
      if (e.key === '?') {
        e.preventDefault();
        showHelp();
        return;
      }

      if (e.key === 'i' || e.key === ':' || e.key === '/') {
        e.preventDefault();
        setVimMode(false);
        input?.focus();
        return;
      }

      if (['j', 'k', 'g', 'G'].includes(e.key)) return;

      if (e.key.length === 1) e.preventDefault();
      return;
    }

    if (target !== input && e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      input?.focus();
      if (input) input.value += e.key;
    }
  });

  setupInputListeners();
  document.addEventListener('astro:after-swap', setupInputListeners);

  function appendOutput(html: string) {
    const terminalOutput = getTerminalOutput();
    if (!terminalOutput) return;
    const line = document.createElement('div');
    line.className = 'terminal-line';
    line.innerHTML = html;
    terminalOutput.appendChild(line);
    requestAnimationFrame(() => scrollToBottom());
  }

  function showCommand(cmd: string) {
    appendOutput(`<span class="prompt-echo">❯</span> <span class="command-echo">${escapeHtml(cmd)}</span>`);
  }

  function escapeHtml(text: string) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function showHelp() {
    const helpText = `
<span class="help-title">Available Commands:</span>
  <span class="help-cmd">ls</span>          List directories and files
  <span class="help-cmd">cd &lt;path&gt;</span>   Navigate to a page (projects, photos, blog, about)
  <span class="help-cmd">pwd</span>         Print current directory
  <span class="help-cmd">cat &lt;file&gt;</span>  View file contents
  <span class="help-cmd">open &lt;name&gt;</span> Open a project on GitHub
  <span class="help-cmd">clear</span>       Clear terminal output
  <span class="help-cmd">help</span>        Show this help message

<span class="help-title">Keyboard Shortcuts:</span>
  <span class="help-key">Escape</span>     Toggle vim mode (prompt turns <span class="help-cmd">blue</span> when active)

  <span class="help-title">In vim mode:</span>
  <span class="help-key">j/k</span>        Navigate lists up/down
  <span class="help-key">Enter</span>      Select/open item
  <span class="help-key">i</span> <span class="help-key">:</span> <span class="help-key">/</span>      Exit vim mode, start typing
  <span class="help-key">?</span>          Show this help`;
    appendOutput(`<pre class="help-output">${helpText}</pre>`);
  }

  function getCurrentPath() {
    return document.querySelector('.tmux-path')?.textContent || '~';
  }

  function executeCommand(cmd: string) {
    showCommand(cmd);

    const parts = cmd.trim().split(/\s+/);
    const command = parts[0].toLowerCase();
    const args = parts.slice(1);

    switch (command) {
      case 'cd':
        const target = args[0] || '~';
        if (target === '~' || target === 'projects' || target === '~/projects' || target === '/') {
          window.location.href = '/';
        } else if (target === 'photos' || target === '~/photos') {
          window.location.href = '/photos';
        } else if (target === 'blog' || target === '~/blog') {
          window.location.href = '/blog';
        } else if (target === 'about' || target === '~/about.md' || target === 'about.md') {
          window.location.href = '/about';
        } else if (target === '..') {
          if (getCurrentPath().includes('/')) window.location.href = '/';
        } else {
          appendOutput(`<span class="error">cd: no such directory: ${escapeHtml(target)}</span>`);
        }
        break;

      case 'ls':
        const lsTarget = args[0] || getCurrentPath();
        let listing = '';

        if (lsTarget === '~' || lsTarget === '/' || lsTarget === '.' || !args[0]) {
          listing = `<span class="dir">projects/</span>  <span class="dir">photos/</span>  <span class="dir">blog/</span>  <span class="file">about.md</span>`;
        } else if (lsTarget === 'projects' || lsTarget === '~/projects') {
          listing = `<span class="file">coppermind</span>  <span class="file">anchor-chain</span>  <span class="file">daedalus</span>  <span class="file">railyard</span>  <span class="file">nenya</span>  <span class="file">atium</span>  <span class="file">reprisedb</span>  <span class="file">bloombox</span>  <span class="file">double_barrel</span>  <span class="file">palantir</span>  <span class="file">chip8-emulator</span>`;
        } else if (lsTarget === 'blog' || lsTarget === '~/blog') {
          listing = `<span class="file">anchor-chain.md</span>  <span class="file">brave-neo-world.md</span>  <span class="file">dotfiles-on-demand.md</span>`;
        } else {
          appendOutput(`<span class="error">ls: cannot access '${escapeHtml(lsTarget)}': No such file or directory</span>`);
          break;
        }
        appendOutput(listing);
        break;

      case 'pwd':
        appendOutput(getCurrentPath());
        break;

      case 'cat':
        const file = args[0];
        if (!file) {
          appendOutput(`<span class="error">cat: missing file operand</span>`);
        } else if (file === 'about.md' || file === '~/about.md') {
          window.location.href = '/about';
        } else {
          appendOutput(`<span class="error">cat: ${escapeHtml(file)}: No such file or directory</span>`);
        }
        break;

      case 'help':
        showHelp();
        break;

      case 'open':
        const item = args[0];
        if (item) {
          const projects = ['coppermind', 'anchor-chain', 'daedalus', 'railyard', 'nenya', 'atium', 'reprisedb', 'bloombox', 'double_barrel', 'palantir', 'chip8-emulator'];
          if (projects.includes(item)) {
            appendOutput(`Opening <span class="link">github.com/emersonmde/${item}</span>...`);
            window.open(`https://github.com/emersonmde/${item}`, '_blank');
          } else {
            appendOutput(`<span class="error">open: unknown project: ${escapeHtml(item)}</span>`);
          }
        } else {
          appendOutput(`<span class="error">open: missing project name</span>`);
        }
        break;

      case 'clear':
        const output = getTerminalOutput();
        if (output) output.innerHTML = '';
        break;

      case 'whoami':
        appendOutput('matthew');
        break;

      case 'echo':
        appendOutput(escapeHtml(args.join(' ')));
        break;

      case 'sudo':
        appendOutput(`<span class="error">Nice try.</span>`);
        break;

      case 'rm':
        if (args.includes('-rf') && (args.includes('/') || args.includes('~'))) {
          appendOutput(`<span class="warning">💥 Boom! Just kidding, this is a static site.</span>`);
        } else {
          appendOutput(`<span class="error">rm: operation not permitted</span>`);
        }
        break;

      case 'vim':
      case 'nvim':
      case 'vi':
        appendOutput(`<span class="success">Ah, I see you're a person of culture.</span>`);
        break;

      case 'emacs':
        appendOutput(`<span class="warning">M-x butterfly</span>`);
        break;

      case 'exit':
        appendOutput('Goodbye!');
        setTimeout(() => {
          window.open('https://github.com/emersonmde', '_blank');
        }, 500);
        break;

      default:
        appendOutput(`<span class="error">command not found: ${escapeHtml(command)}</span>`);
    }
  }
</script>

<style>
  .terminal {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    background-color: var(--es-black);
    font-family: var(--es-font-mono);
  }

  .terminal-window {
    display: flex;
    flex-direction: column;
    max-width: 1000px;
    width: 100%;
    min-height: 100vh;
    background-color: var(--es-bg-dim);
  }

  .terminal-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--es-space-4);
    overflow: auto;
  }

  .prompt-line {
    display: flex;
    align-items: center;
    margin-top: auto;
    padding-top: var(--es-space-4);
  }

  .prompt-symbol {
    color: var(--es-green);
    font-weight: bold;
    margin-right: var(--es-space-2);
    transition: color 0.15s ease;
  }

  .prompt-symbol.vim-mode {
    color: var(--es-blue);
  }

  .prompt-input-wrapper {
    display: flex;
    align-items: center;
    flex: 1;
    position: relative;
  }

  .prompt-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--es-fg);
    font-family: var(--es-font-mono);
    font-size: var(--es-text-base);
    padding: 0;
    outline: none;
    caret-color: var(--es-fg);
  }

  .prompt-cursor {
    position: absolute;
    left: 0;
    width: 8px;
    height: 1.2em;
    background-color: var(--es-fg);
    animation: blink 1s step-end infinite;
  }

  .prompt-input:focus ~ .prompt-cursor {
    display: none;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  #terminal-output {
    display: flex;
    flex-direction: column;
    gap: var(--es-space-1);
  }

  #terminal-output:empty {
    display: none;
  }

  #terminal-output:not(:empty) {
    margin-top: var(--es-space-4);
    padding-top: var(--es-space-4);
    border-top: 1px solid var(--es-border);
  }

  :global(.terminal-line) {
    font-family: var(--es-font-mono);
    font-size: var(--es-text-sm);
    line-height: 1.5;
  }

  :global(.prompt-echo) {
    color: var(--es-green);
    font-weight: bold;
  }

  :global(.command-echo) {
    color: var(--es-fg);
  }

  :global(.error) {
    color: var(--es-red);
  }

  :global(.warning) {
    color: var(--es-orange);
  }

  :global(.success) {
    color: var(--es-green);
  }

  :global(.dir) {
    color: var(--es-blue);
  }

  :global(.file) {
    color: var(--es-fg);
  }

  :global(.link) {
    color: var(--es-blue);
    text-decoration: underline;
  }

  :global(.help-output) {
    margin: 0;
    font-family: var(--es-font-mono);
    font-size: var(--es-text-sm);
    line-height: 1.6;
  }

  :global(.help-title) {
    color: var(--es-green);
    font-weight: bold;
  }

  :global(.help-cmd) {
    color: var(--es-blue);
  }

  :global(.help-key) {
    color: var(--es-orange);
  }

  @media (max-width: 640px) {
    .terminal-content {
      padding: var(--es-space-3);
    }
  }
</style>
