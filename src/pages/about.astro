---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, SOCIAL } from '../consts';
---

<BaseLayout
  title="About"
  description="About Matthew Emerson - Software Development Manager"
  virtualPath="~/about.md"
  activeTab=""
>
  <article class="about-page">
      <h1 class="about-heading"># About</h1>

      <p class="about-intro">
        I'm <strong>{AUTHOR.name}</strong>, a Software Development Manager at Amazon.
      </p>

      <p>
        I lead a cross-functional team of software engineers and applied scientists
        building AI/ML features for talent acquisition. We focus on rapid experimentation
        with LLMs and agentic systems to transform hiring workflows at scale.
      </p>

      <p>
        Outside of work, I'm drawn to systems programming and understanding how things
        work at a fundamental level. I spend my free time building databases, consensus
        protocols, emulators, and other low-level systems.
      </p>

      <section class="about-section">
        <h2 class="section-heading">## Skills</h2>

        <div class="skills-grid">
          <div class="skill-row">
            <span class="skill-label">Languages:</span>
            <span class="skill-value">Rust, Java, Python, C, TypeScript</span>
          </div>
          <div class="skill-row">
            <span class="skill-label">Systems:</span>
            <span class="skill-value">AWS, DynamoDB, PostgreSQL, Linux</span>
          </div>
          <div class="skill-row">
            <span class="skill-label">Interests:</span>
            <span class="skill-value">
              Distributed systems, storage engines, protocols, algorithms, operating systems, emulators
            </span>
          </div>
        </div>
      </section>

      <section class="about-section">
        <h2 class="section-heading">## Links</h2>

        <div class="links-list">
          <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="link-row">
            <span class="link-label">github</span>
            <span class="link-arrow">→</span>
            <span class="link-value">github.com/emersonmde</span>
          </a>
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="link-row">
            <span class="link-label">linkedin</span>
            <span class="link-arrow">→</span>
            <span class="link-value">linkedin.com/in/emersonmde</span>
          </a>
          <a href="/photos" class="link-row">
            <span class="link-label">photos</span>
            <span class="link-arrow">→</span>
            <span class="link-value">errorsignal.dev/photos</span>
          </a>
        </div>
      </section>
  </article>
</BaseLayout>

<style>
  .about-page {
    max-width: 60ch;
  }

  .about-heading {
    color: var(--es-green);
    font-size: var(--es-text-2xl);
    margin-bottom: var(--es-space-6);
  }

  .about-intro {
    margin-bottom: var(--es-space-4);
  }

  .about-intro strong {
    color: var(--es-fg);
  }

  .about-section {
    margin-top: var(--es-space-8);
  }

  .section-heading {
    color: var(--es-green);
    font-size: var(--es-text-lg);
    margin-bottom: var(--es-space-4);
  }

  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: var(--es-space-2);
  }

  .skill-row {
    display: flex;
    gap: var(--es-space-4);
  }

  .skill-label {
    color: var(--es-grey);
    min-width: 12ch;
    flex-shrink: 0;
  }

  .skill-value {
    color: var(--es-fg);
  }

  .links-list {
    display: flex;
    flex-direction: column;
    gap: var(--es-space-2);
  }

  .link-row {
    display: flex;
    gap: var(--es-space-3);
    text-decoration: none;
    padding: var(--es-space-1) 0;
    transition: background-color var(--es-duration-fast) var(--es-easing);
  }

  .link-row:hover {
    background-color: var(--es-bg3);
  }

  .link-label {
    color: var(--es-grey);
    min-width: 10ch;
    flex-shrink: 0;
  }

  .link-arrow {
    color: var(--es-grey-dim);
  }

  .link-value {
    color: var(--es-blue);
  }

  .link-row:hover .link-value {
    color: var(--es-green);
  }

  @media (max-width: 640px) {
    .skill-row {
      flex-direction: column;
      gap: var(--es-space-1);
    }

    .skill-label {
      min-width: auto;
    }
  }
</style>
