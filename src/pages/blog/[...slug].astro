---
import { getCollection } from 'astro:content';
import Moved from '../../layouts/Moved.astro';

/**
 * Post URLs are 1:1 with memerson.com — every slug was preserved during the
 * content migration. The paths are still derived from the collection rather
 * than hardcoded, so a post that exists here cannot silently lose its
 * redirect.
 */
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { to: `https://memerson.com/blog/${post.id}/` },
  }));
}

const { to } = Astro.props;
---

<Moved to={to} />
