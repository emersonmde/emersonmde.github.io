---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sortedPosts = posts.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index > 0 ? sortedPosts[index - 1] : null,
      nextPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: '2-digit',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  virtualPath={`~/blog/${post.id}`}
  statusHints="INSERT"
  activeTab="blog"
>
  <article class="blog-post" itemscope itemtype="http://schema.org/Article">
    <header class="post-header">
      <h1 class="post-title" itemprop="headline">{post.data.title}</h1>
      <time class="post-date" datetime={post.data.date.toISOString()}>
        {formattedDate}
      </time>
    </header>

    <hr class="post-divider" />

    <section class="post-content" itemprop="articleBody">
      <Content />
    </section>
  </article>

  <nav class="post-nav">
    <div class="nav-prev">
      {prevPost && (
        <a href={`/blog/${prevPost.id}/`} rel="prev">
          ← prev: {prevPost.data.title}
        </a>
      )}
    </div>
    <div class="nav-next">
      {nextPost && (
        <a href={`/blog/${nextPost.id}/`} rel="next">
          next: {nextPost.data.title} →
        </a>
      )}
    </div>
  </nav>
</BaseLayout>

<style>
  .blog-post {
    max-width: var(--es-content-width);
  }

  .post-header {
    margin-bottom: var(--es-space-4);
  }

  .post-title {
    font-size: var(--es-text-2xl);
    margin-bottom: var(--es-space-2);
    color: var(--es-fg);
  }

  .post-date {
    color: var(--es-grey);
    font-size: var(--es-text-sm);
  }

  .post-divider {
    border: none;
    height: 1px;
    background: var(--es-border);
    margin: var(--es-space-4) 0 var(--es-space-6);
  }

  .post-content {
    font-family: var(--es-font-prose);
    font-size: var(--es-text-lg);
    line-height: var(--es-leading-relaxed);
    color: var(--es-fg);
  }

  /* Prose typography */
  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    font-family: var(--es-font-mono);
    margin-top: var(--es-space-8);
    margin-bottom: var(--es-space-4);
    color: var(--es-fg);
  }

  .post-content :global(h2) {
    font-size: var(--es-text-xl);
  }

  .post-content :global(h3) {
    font-size: var(--es-text-lg);
  }

  .post-content :global(p) {
    margin-bottom: var(--es-space-4);
  }

  .post-content :global(a) {
    color: var(--es-blue);
    text-decoration: underline;
    text-decoration-color: var(--es-border);
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    color: var(--es-green);
    text-decoration-color: var(--es-green);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--es-space-4);
    padding-left: var(--es-space-6);
  }

  .post-content :global(li) {
    margin-bottom: var(--es-space-2);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--es-green);
    padding-left: var(--es-space-4);
    margin: var(--es-space-6) 0;
    color: var(--es-grey);
    font-style: italic;
  }

  .post-content :global(pre) {
    font-family: var(--es-font-mono);
    font-size: var(--es-text-sm);
    background-color: var(--es-bg0);
    border: 1px solid var(--es-border);
    border-radius: 4px;
    padding: var(--es-space-4);
    overflow-x: auto;
    margin: var(--es-space-6) 0;
  }

  .post-content :global(code) {
    font-family: var(--es-font-mono);
  }

  .post-content :global(:not(pre) > code) {
    background-color: var(--es-bg2);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    color: var(--es-orange);
    font-size: 0.9em;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--es-border);
    border-radius: 4px;
    margin: var(--es-space-4) 0;
  }

  .post-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--es-border);
    margin: var(--es-space-8) 0;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--es-space-6) 0;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--es-border);
    padding: var(--es-space-2) var(--es-space-3);
    text-align: left;
  }

  .post-content :global(th) {
    background-color: var(--es-bg2);
  }

  /* Post navigation */
  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--es-space-4);
    padding: var(--es-space-4);
    margin-top: var(--es-space-4);
  }

  .nav-prev,
  .nav-next {
    flex: 1;
  }

  .nav-next {
    text-align: right;
  }

  .post-nav a {
    color: var(--es-blue);
    text-decoration: none;
    font-size: var(--es-text-sm);
    transition: color var(--es-duration-fast) var(--es-easing);
  }

  .post-nav a:hover {
    color: var(--es-green);
  }

  @media (max-width: 640px) {
    .post-content {
      font-size: var(--es-text-base);
    }

    .post-nav {
      flex-direction: column;
      gap: var(--es-space-2);
    }

    .nav-next {
      text-align: left;
    }
  }
</style>
