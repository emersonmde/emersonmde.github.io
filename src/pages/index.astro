---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { AUTHOR, SOCIAL } from '../consts';

const projectEntries = await getCollection('projects');
const projects = projectEntries
  .map((entry) => ({
    ...entry.data,
    languageColor: entry.data.language === 'c' ? 'var(--es-blue)' : 'var(--es-orange)',
  }))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Projects"
  description="Matthew Emerson's portfolio - Systems engineering projects in Rust, C, and more"
  virtualPath="~/projects"
  statusHints="INSERT"
  activeTab="projects"
>
  <div class="projects-page">
      <section class="bio-section">
        <h1 class="bio-name"><a href="/about" class="bio-name-link">{AUTHOR.name}</a></h1>
        <p class="bio-title">{AUTHOR.summary}</p>
        <div class="bio-links">
          <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">
            github.com/emersonmde
          </a>
          <span class="bio-separator">·</span>
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">
            linkedin.com/in/emersonmde
          </a>
        </div>
      </section>

      <hr class="divider" />

      <section class="projects-section">
        <ul class="projects-list" role="list" id="projects-list">
          {projects.map((project, index) => (
            <li
              class="project-row"
              data-project={project.name}
              data-index={index}
              data-github={project.github}
              data-demo={project.demo || ''}
              data-docs={project.docs || ''}
              data-crate={project.crate || ''}
              tabindex="0"
              role="button"
              aria-expanded={index === 0 ? "true" : "false"}
            >
              <div class="project-summary">
                <span class="project-indicator">▸</span>
                <div class="project-info">
                  <span class="project-name">{project.name}</span>
                  <span class="project-short-desc">{project.shortDescription}</span>
                </div>
                <span class="project-tags">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </span>
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-github-link"
                  onclick="event.stopPropagation();"
                  title="View on GitHub"
                >
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                  </svg>
                </a>
              </div>

              <div class="project-expanded" aria-hidden={index === 0 ? "false" : "true"}>
                <div class="expanded-content">
                  <div class="expanded-main">
                    <p class="project-description">{project.description}</p>
                  </div>
                  <div class="expanded-sidebar">
                    <div class="sidebar-section">
                      <span class="sidebar-label">links</span>
                      <div class="sidebar-links">
                        <a
                          href={project.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="action-link"
                        >
                          <span class="action-key">[g]</span> GitHub
                        </a>
                        {project.demo && (
                          <a
                            href={project.demo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link demo"
                          >
                            <span class="action-key">[d]</span> Demo
                          </a>
                        )}
                        {project.docs && (
                          <a
                            href={project.docs}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link docs"
                          >
                            <span class="action-key">[r]</span> Docs
                          </a>
                        )}
                        {project.crate && (
                          <a
                            href={project.crate}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action-link crate"
                          >
                            <span class="action-key">[c]</span> Crate
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>

        <button class="show-more-btn" id="show-more-btn" aria-hidden="true">
          show <span id="hidden-count">0</span> more
        </button>
      </section>
  </div>
</BaseLayout>

<style>
  .projects-page {
    max-width: var(--es-content-width);
  }

  /* Bio Section */
  .bio-section {
    margin-bottom: var(--es-space-4);
  }

  .bio-name {
    font-size: var(--es-text-xl);
    margin-bottom: var(--es-space-1);
  }

  .bio-name-link {
    color: var(--es-fg);
    text-decoration: none;
    transition: color var(--es-duration-fast) var(--es-easing);
  }

  .bio-name-link:hover {
    color: var(--es-green);
  }

  .bio-title {
    color: var(--es-grey);
    margin-bottom: var(--es-space-2);
  }

  .bio-links {
    font-size: var(--es-text-sm);
  }

  .bio-links a {
    color: var(--es-blue);
  }

  .bio-separator {
    color: var(--es-grey-dim);
    margin: 0 var(--es-space-2);
  }

  /* Dividers */
  .divider {
    border: none;
    height: 1px;
    background: var(--es-border);
    margin: var(--es-space-4) 0;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Project Row */
  .project-row {
    cursor: pointer;
    transition: all var(--es-duration-fast) var(--es-easing);
    border-left: 3px solid transparent;
    margin-bottom: 1px;
  }

  .project-row:hover,
  .project-row:focus {
    background-color: var(--es-bg2);
    border-left-color: var(--es-grey);
    outline: none;
  }

  .project-row[aria-expanded='true'] {
    background-color: var(--es-bg0);
    border-left-color: var(--es-green);
    margin-bottom: var(--es-space-2);
  }

  .project-summary {
    display: flex;
    align-items: center;
    gap: var(--es-space-3);
    padding: var(--es-space-2) var(--es-space-3);
  }

  .project-indicator {
    color: var(--es-green);
    font-size: var(--es-text-base);
    transition: transform var(--es-duration-fast) var(--es-easing);
    flex-shrink: 0;
    width: 1.5ch;
  }

  .project-row[aria-expanded='true'] .project-indicator {
    transform: rotate(90deg);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 200px;
  }

  .project-name {
    color: var(--es-fg);
    font-weight: bold;
    font-size: var(--es-text-base);
  }

  .project-row[aria-expanded='true'] .project-name {
    color: var(--es-green);
  }

  .project-short-desc {
    color: var(--es-grey);
    font-size: var(--es-text-xs);
  }

  .project-tags {
    display: flex;
    gap: var(--es-space-2);
    margin-left: auto;
  }

  .tag {
    font-size: var(--es-text-xs);
    color: var(--es-purple);
    background: transparent;
    border: 1px solid var(--es-purple);
    padding: 1px 6px;
    border-radius: 3px;
    font-family: var(--es-font-mono);
    opacity: 0.7;
    transition: opacity var(--es-duration-fast);
  }

  .project-row:hover .tag,
  .project-row[aria-expanded='true'] .tag {
    opacity: 1;
  }

  .project-github-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--es-grey);
    padding: var(--es-space-1);
    margin-left: var(--es-space-2);
    border-radius: 4px;
    transition: color var(--es-duration-fast), background-color var(--es-duration-fast);
    flex-shrink: 0;
  }

  .project-github-link:hover {
    color: var(--es-fg);
    background-color: var(--es-bg2);
  }

  .project-row[aria-expanded='true'] .project-github-link {
    display: none;
  }

  /* Expanded View */
  .project-expanded {
    display: none;
    padding: var(--es-space-3) var(--es-space-3) var(--es-space-4);
    padding-left: calc(var(--es-space-3) + 1.5ch + var(--es-space-3));
    border-top: 1px solid var(--es-border-dim);
  }

  .project-row[aria-expanded='true'] .project-expanded {
    display: block;
  }

  .expanded-content {
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: var(--es-space-6);
  }

  .expanded-main {
    min-width: 0;
  }

  .project-description {
    color: var(--es-fg);
    font-size: var(--es-text-sm);
    line-height: 1.7;
    margin: 0;
  }

  /* Sidebar */
  .expanded-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--es-space-4);
    border-left: 1px solid var(--es-border-dim);
    padding-left: var(--es-space-4);
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: var(--es-space-2);
  }

  .sidebar-label {
    font-size: var(--es-text-xs);
    color: var(--es-grey-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: var(--es-space-1);
  }

  .action-link {
    display: flex;
    align-items: center;
    gap: var(--es-space-2);
    font-size: var(--es-text-sm);
    color: var(--es-fg);
    text-decoration: none;
    padding: var(--es-space-1) 0;
    transition: all var(--es-duration-fast);
  }

  .action-link:hover {
    color: var(--es-green);
  }

  .action-key {
    font-family: var(--es-font-mono);
    font-size: var(--es-text-xs);
    color: var(--es-grey);
    min-width: 2.5ch;
  }

  .action-link:hover .action-key {
    color: var(--es-green);
  }

  .action-link.demo {
    color: var(--es-green);
  }

  .action-link.docs {
    color: var(--es-blue);
  }

  /* Show more button */
  .show-more-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--es-space-2);
    width: 100%;
    padding: var(--es-space-2) var(--es-space-3);
    background: transparent;
    border: 1px dashed var(--es-border);
    color: var(--es-grey);
    font-family: var(--es-font-mono);
    font-size: var(--es-text-sm);
    cursor: pointer;
    transition: all var(--es-duration-fast);
    margin-top: var(--es-space-1);
  }

  .show-more-btn:hover {
    border-color: var(--es-green);
    color: var(--es-green);
    background: var(--es-bg2);
  }

  .show-more-btn[aria-hidden="true"] {
    display: none;
  }


  /* Hidden project rows */
  .project-row.hidden-overflow {
    display: none;
  }

  .projects-list.show-all .project-row.hidden-overflow {
    display: block;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .project-summary {
      flex-wrap: wrap;
    }

    .project-info {
      min-width: auto;
      flex: 1;
    }

    .project-tags {
      width: 100%;
      margin-left: 0;
      margin-top: var(--es-space-2);
      padding-left: calc(1.5ch + var(--es-space-3));
    }

    .expanded-content {
      grid-template-columns: 1fr;
      gap: var(--es-space-4);
    }

    .expanded-sidebar {
      flex-direction: row;
      border-left: none;
      border-top: 1px solid var(--es-border-dim);
      padding-left: 0;
      padding-top: var(--es-space-3);
      gap: var(--es-space-6);
    }

    .sidebar-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--es-space-3);
    }
  }
</style>

<script>
  interface VimWindow extends Window { vimMode: boolean; }
  declare const window: VimWindow;

  function calculateVisibleProjects() {
    const projectsList = document.getElementById('projects-list');
    const showMoreBtn = document.getElementById('show-more-btn');
    const hiddenCountSpan = document.getElementById('hidden-count');
    const rows = Array.from(document.querySelectorAll('.project-row')) as HTMLElement[];

    if (!projectsList || !showMoreBtn || !hiddenCountSpan || rows.length === 0) return;
    if (projectsList.classList.contains('show-all')) return;

    const viewportHeight = window.innerHeight;
    const bioSection = document.querySelector('.bio-section') as HTMLElement;
    const divider = document.querySelector('.divider') as HTMLElement;
    const statusBar = document.querySelector('.tmux-bar') as HTMLElement;
    const promptLine = document.getElementById('prompt-line');

    const bioHeight = bioSection?.offsetHeight || 0;
    const dividerHeight = divider?.offsetHeight || 0;
    const statusBarHeight = statusBar?.offsetHeight || 28;
    const promptHeight = promptLine?.offsetHeight || 40;
    const padding = 120;

    const fixedHeight = bioHeight + dividerHeight + statusBarHeight + promptHeight + padding;
    const availableHeight = viewportHeight - fixedHeight;

    const firstRow = rows[0];
    const wasExpanded = firstRow.getAttribute('aria-expanded') === 'true';
    if (wasExpanded) firstRow.setAttribute('aria-expanded', 'false');
    const rowHeight = firstRow.offsetHeight + 1;
    if (wasExpanded) firstRow.setAttribute('aria-expanded', 'true');

    const expandedExtraHeight = wasExpanded ? 120 : 0;
    const maxVisibleRows = Math.floor((availableHeight - expandedExtraHeight) / rowHeight);
    const visibleCount = Math.max(2, Math.min(maxVisibleRows, rows.length));

    rows.forEach(row => row.classList.remove('hidden-overflow'));

    const hiddenCount = rows.length - visibleCount;
    if (hiddenCount > 0) {
      rows.slice(visibleCount).forEach(row => row.classList.add('hidden-overflow'));
      hiddenCountSpan.textContent = String(hiddenCount);
      showMoreBtn.setAttribute('aria-hidden', 'false');
    } else {
      showMoreBtn.setAttribute('aria-hidden', 'true');
    }
  }

  const showMoreBtn = document.getElementById('show-more-btn');
  const projectsList = document.getElementById('projects-list');

  showMoreBtn?.addEventListener('click', () => {
    projectsList?.classList.add('show-all');
    showMoreBtn.setAttribute('aria-hidden', 'true');
    setTimeout(() => {
      window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }, 50);
  });

  calculateVisibleProjects();

  let resizeTimeout: number;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = window.setTimeout(() => {
      if (!projectsList?.classList.contains('show-all')) calculateVisibleProjects();
    }, 150);
  });

  function setupProjectListeners() {
    document.querySelectorAll('.project-row').forEach((row) => {
      row.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a')) return;

        const isExpanded = row.getAttribute('aria-expanded') === 'true';

        document.querySelectorAll('.project-row').forEach((r) => {
          r.setAttribute('aria-expanded', 'false');
          r.querySelector('.project-expanded')?.setAttribute('aria-hidden', 'true');
        });

        if (!isExpanded) {
          row.setAttribute('aria-expanded', 'true');
          row.querySelector('.project-expanded')?.setAttribute('aria-hidden', 'false');
        }
      });

      row.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          (row as HTMLElement).click();
        }
      });
    });
  }

  setupProjectListeners();
  document.addEventListener('astro:after-swap', setupProjectListeners);

  document.addEventListener('keydown', (e) => {
    if (!window.vimMode) return;

    const rows = Array.from(document.querySelectorAll('.project-row')) as HTMLElement[];
    const focusedIndex = rows.findIndex((r) => r === document.activeElement);

    if (e.key === 'j' || e.key === 'ArrowDown') {
      e.preventDefault();
      const nextIndex = focusedIndex < rows.length - 1 ? focusedIndex + 1 : 0;
      rows[nextIndex].focus();
    } else if (e.key === 'k' || e.key === 'ArrowUp') {
      e.preventDefault();
      const prevIndex = focusedIndex > 0 ? focusedIndex - 1 : rows.length - 1;
      rows[prevIndex].focus();
    } else if (document.activeElement?.classList.contains('project-row')) {
      const row = document.activeElement as HTMLElement;
      const github = row.dataset.github;
      const demo = row.dataset.demo;
      const docs = row.dataset.docs;
      const crate = row.dataset.crate;

      if (e.key === 'g' && github) {
        e.preventDefault();
        window.open(github, '_blank');
      } else if (e.key === 'd' && demo) {
        e.preventDefault();
        window.open(demo, '_blank');
      } else if (e.key === 'r' && docs) {
        e.preventDefault();
        window.open(docs, '_blank');
      } else if (e.key === 'c' && crate) {
        e.preventDefault();
        window.open(crate, '_blank');
      }
    }
  });
</script>
